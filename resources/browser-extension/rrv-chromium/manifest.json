{
  "manifest_version": 3,
  "name": "RR-V Browser Connector",
  "short_name": "RR-V",
  "version": "0.1.4",
  "description": "현재 페이지나 링크를 RR-V 다운로드 목록으로 보냅니다.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "현재 페이지를 RR-V로 보내기",
    "default_icon": "RR-V.png"
  },
  "icons": {
    "16": "RR-V.png",
    "32": "RR-V.png",
    "48": "RR-V.png",
    "128": "RR-V.png"
  },
  "host_permissions": [
    "http://127.0.0.1:47813/*"
  ]
}
