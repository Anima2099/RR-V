QScrollArea#subtitleQueueScroll > QWidget > QWidget {
    background-color: transparent;
}

QFrame#subtitleTrackBox {
    background-color: #EEECE5;
    border: 1px solid #D5D2C9;
    border-radius: 9px;
}

QLabel#subtitleTrackTitle {
    font-weight: 700;
    color: #46534D;
}

QPushButton#compactButton {
    min-height: 28px;
    max-height: 28px;
    padding: 0 9px;
    background-color: #E5E7E1;
    color: #46514B;
    border: 1px solid #C4C8C1;
    border-radius: 7px;
}

QPushButton#compactButton:hover {
    background-color: #DCE2DC;
    border-color: #AAB4AC;
}

QFrame#subtitleTaskRow {
    background-color: #F7F4EB;
    border: 1px solid #D2D0C7;
    border-radius: 9px;
}

QLabel#subtitleTaskTitle {
    background-color: transparent;
    color: #34413C;
    font-weight: 700;
    min-width: 0px;
}

QLabel#subtitleTaskMatch {
    background-color: transparent;
    color: #68716B;
    font-size: 10.5pt;
    min-width: 0px;
}

QLabel#subtitleTaskMatch[matchState="matched"] {
    color: #557955;
}

QLabel#subtitleTaskMatch[matchState="missing"] {
    color: #9A6A50;
}

QLabel#subtitleTaskStatus {
    min-height: 28px;
    padding-left: 9px;
    padding-right: 9px;
    background-color: #E7E7E1;
    color: #68716B;
    border-radius: 7px;
    font-weight: 700;
}

QLabel#subtitleTaskStatus[taskState="running"] {
    background-color: #D9E5E9;
    color: #4E7486;
}

QLabel#subtitleTaskStatus[taskState="done"] {
    background-color: #DDEADB;
    color: #557955;
}

QLabel#subtitleTaskStatus[taskState="warning"] {
    background-color: #EEE5D8;
    color: #8A6A4D;
}

QLabel#subtitleTaskStatus[taskState="failed"],
QLabel#subtitleTaskStatus[taskState="stopped"] {
    background-color: #EBDDD9;
    color: #985E55;
}

QLabel#subtitleQueueEmpty {
    min-height: 88px;
    color: #8B918C;
}

QFrame#subtitleStatusBar {
    background-color: #F7F4EB;
    border: 1px solid #D2D0C7;
    border-radius: 11px;
}

QLabel#subtitleStatusTitle {
    background-color: transparent;
    color: #34413C;
    font-weight: 700;
    font-size: 12pt;
}

QLabel#subtitleStatusText {
    background-color: transparent;
    color: #4E5A53;
    padding: 1px 4px;
}

QLabel#subtitleStatusCounter {
    min-width: 60px;
    background-color: transparent;
    color: #6B7770;
    qproperty-alignment: AlignCenter;
}

QPushButton#subtitleStatusDetailsButton {
    min-height: 28px;
    max-height: 28px;
    padding: 0 9px;
    background-color: transparent;
    color: #60726A;
    border: 1px solid transparent;
    border-radius: 7px;
}

QPushButton#subtitleStatusDetailsButton:hover {
    background-color: #E7ECE6;
    border-color: #CBD2CA;
}

QPushButton#subtitleQuickActionButton {
    min-height: 28px;
    max-height: 28px;
    padding: 0 11px;
    background-color: #E5E7E1;
    color: #46514B;
    border: 1px solid #C4C8C1;
    border-radius: 7px;
}

QPushButton#subtitleQuickActionButton:hover {
    background-color: #DCE2DC;
    border-color: #AAB4AC;
}

QProgressBar#subtitleStatusProgress {
    min-height: 20px;
    max-height: 20px;
    background-color: #E5E4DE;
    color: #59605B;
    border: none;
    border-radius: 6px;
}

QProgressBar#subtitleStatusProgress::chunk {
    background-color: #608598;
    border-radius: 6px;
}

QPushButton#subtitleStatusStopButton {
    min-height: 30px;
    max-height: 30px;
    padding: 0 12px;
    background-color: #E7D8D4;
    color: #8D554F;
    border: 1px solid #D1B8B1;
    border-radius: 8px;
    font-weight: 700;
}

QFrame#subtitleStatusDetail {
    background-color: #EEECE5;
    border: 1px solid #D5D2C9;
    border-radius: 8px;
}

QLabel#subtitleStatusDetailText {
    background-color: transparent;
    color: #59645E;
}

/* ---------------------------------------------------------
   v0.10.1 subtitle combo popup + inline help polish
--------------------------------------------------------- */

QComboBox#settingsComboBox {
    min-height: 38px;
    padding: 0 10px;
    background-color: #FCF9F1;
    color: #34413C;
    border: 1px solid #C5C4BD;
    border-radius: 9px;
}

QComboBox#settingsComboBox:hover {
    border-color: #9FAAA3;
}

QComboBox#settingsComboBox:focus {
    border: 2px solid #608598;
}

QComboBox#settingsComboBox::drop-down {
    width: 30px;
    background-color: #EFF1EB;
    border: none;
    border-left: 1px solid #D8D9D2;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox#settingsComboBox::drop-down:hover {
    background-color: #DCE3DB;
}

QComboBox#settingsComboBox::down-arrow {
    width: 12px;
    height: 8px;
    image: url(__SPIN_DOWN_ICON__);
}

QComboBox#settingsComboBox QLineEdit {
    background-color: #FCF9F1;
    color: #34413C;
    border: none;
    padding: 0 2px;
}

QComboBox#settingsComboBox QAbstractItemView {
    background-color: #FCF9F1;
    color: #34413C;
    border: 1px solid #BFC5BE;
    selection-background-color: #DDE7E8;
    selection-color: #34413C;
    outline: 0;
}

/* ---------------------------------------------------------
   DEV13.4 browser integration controls
--------------------------------------------------------- */
QLabel#browserIntegrationStatus {
    color: #657068;
    font-size: 11pt;
    font-weight: 700;
}

QToolButton#browserConnectionSwitch {
    min-width: 64px;
    max-width: 64px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
    background-color: #E2E3DE;
    color: #737872;
    border: 1px solid #C5C8C1;
    border-radius: 17px;
    font-size: 10.5pt;
    font-weight: 700;
}

QToolButton#browserConnectionSwitch:hover {
    border-color: #AEB6AD;
    background-color: #EAEBE6;
}

QToolButton#browserConnectionSwitch[connectionState="on"] {
    background-color: #8EAB99;
    color: #FBF8EF;
    border-color: #789685;
}

QToolButton#browserConnectionSwitch[connectionState="on"]:hover {
    background-color: #9AB6A4;
}

QToolButton#browserConnectionSwitch:disabled {
    background-color: #D8D9D4;
    color: #9A9D98;
    border-color: #CFD1CB;
}

QFrame#browserGuideFrame {
    background-color: #F1EFE7;
    border: 1px solid #D4D1C7;
    border-radius: 10px;
}

QLabel#settingsSubTitle {
    color: #44514A;
    font-size: 11.5pt;
    font-weight: 700;
}

QLabel#browserGuideNote {
    color: #7A6E59;
    font-size: 10.5pt;
    font-weight: 700;
    padding-top: 4px;
}
